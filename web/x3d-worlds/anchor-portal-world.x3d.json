{
  "X3D": {
    "encoding": "UTF-8",
    "@profile": "Interactive",
    "@version": "4.0",
    "@xsd:noNamespaceSchemaLocation": "https://www.web3d.org/specifications/x3d-4.0.xsd",
    "JSON schema": "https://www.web3d.org/specifications/x3d-4.0-JSONSchema.autogenerated.json",
    "head": {
      "component": [
        { "@name": "Networking", "@level": 2 },
        { "@name": "EnvironmentalSensor", "@level": 1 },
        { "@name": "Text", "@level": 1 }
      ],
      "meta": [
        { "@name": "title", "@content": "anchor-portal-world.x3d.json" },
        { "@name": "description", "@content": "Open Spatial Lab test world in the X3D JSON encoding. Its portal is an X3D Anchor whose url is a Web of Worlds world address (Location B), with a ProximitySensor as its walk-in trigger. Written by hand, as a portal shape for John Carlson's Ex3D JSON finding." },
        { "@name": "creator", "@content": "Open Spatial Lab contributors" },
        { "@name": "created", "@content": "2026-10-27" },
        { "@name": "modified", "@content": "2026-10-30" },
        { "@name": "license", "@content": "Apache-2.0" },
        { "@name": "reference", "@content": "X3D 4.0 Anchor node: https://www.web3d.org/specifications/X3Dv4/ISO-IEC19775-1v4-IS/Part01/components/networking.html#Anchor" }
      ]
    },
    "Scene": {
      "-children": [
        {
          "WorldInfo": {
            "@DEF": "OSL_WorldInfo",
            "@title": "Anchor portal test world",
            "@info": ["Open Spatial Lab renderer lane test world", "Click the orange disc, or walk into it, to cross to Location B"]
          }
        },
        {
          "NavigationInfo": {
            "@type": ["WALK", "EXAMINE", "ANY"],
            "@avatarSize": [0.25, 1.6, 0.75],
            "@speed": 2,
            "@headlight": false
          }
        },
        {
          "Viewpoint": {
            "@DEF": "Entry",
            "@description": "Entry, facing the portal",
            "@position": [0, 1.6, 6],
            "@orientation": [0, 1, 0, 0],
            "@fieldOfView": 0.9
          }
        },
        { "Background": { "@skyColor": [0.09, 0.13, 0.22] } },
        {
          "DirectionalLight": {
            "@direction": [-0.4, -1, -0.6],
            "@intensity": 0.9,
            "@ambientIntensity": 0.5,
            "@global": true
          }
        },
        {
          "Transform": {
            "@DEF": "Floor",
            "@translation": [0, -0.05, 0],
            "-children": [
              {
                "Shape": {
                  "-appearance": { "Appearance": { "-material": { "Material": { "@diffuseColor": [0.11, 0.32, 0.5], "@ambientIntensity": 1 } } } },
                  "-geometry": { "Box": { "@size": [14, 0.1, 18] } }
                }
              }
            ]
          }
        },
        {
          "Transform": {
            "@DEF": "BackWall",
            "@translation": [0, 2.5, -6],
            "-children": [
              {
                "Shape": {
                  "-appearance": { "Appearance": { "-material": { "Material": { "@diffuseColor": [0.2, 0.42, 0.62], "@ambientIntensity": 1 } } } },
                  "-geometry": { "Box": { "@size": [14, 5, 0.2] } }
                }
              }
            ]
          }
        },
        {
          "Transform": {
            "@DEF": "ColumnLeft",
            "@translation": [-3.2, 1.5, -2.5],
            "-children": [
              {
                "Shape": {
                  "-appearance": { "Appearance": { "-material": { "Material": { "@diffuseColor": [0.85, 0.87, 0.9], "@ambientIntensity": 1 } } } },
                  "-geometry": { "Cylinder": { "@radius": 0.3, "@height": 3 } }
                }
              }
            ]
          }
        },
        {
          "Transform": {
            "@DEF": "ColumnRight",
            "@translation": [3.2, 1.5, -2.5],
            "-children": [
              {
                "Shape": {
                  "-appearance": { "Appearance": { "-material": { "Material": { "@diffuseColor": [0.85, 0.87, 0.9], "@ambientIntensity": 1 } } } },
                  "-geometry": { "Cylinder": { "@radius": 0.3, "@height": 3 } }
                }
              }
            ]
          }
        },
        {
          "ProximitySensor": {
            "@DEF": "PortalTrigger",
            "@center": [0, 1.2, -2.5],
            "@size": [2.4, 3, 1.2]
          }
        },
        {
          "Transform": {
            "@DEF": "PortalToLocationB",
            "@translation": [0, 1.2, -2.5],
            "-children": [
              {
                "Anchor": {
                  "@DEF": "PortalAnchor",
                  "@description": "Portal to Location B",
                  "@url": ["/w/b/"],
                  "@parameter": ["target=_self"],
                  "-metadata": {
                    "MetadataSet": {
                      "@name": "wow:portal",
                      "@reference": "https://github.com/WebOfWorlds/WoWAPI",
                      "-value": [
                        { "MetadataString": { "@name": "target_world", "@value": ["demo-room-b"] } },
                        { "MetadataString": { "@name": "target_location_id", "@value": ["location-b"] } },
                        { "MetadataString": { "@name": "crossing", "@value": ["walk-through-or-activate"] } },
                        { "MetadataFloat": { "@name": "radius_m", "@value": [1.1] } }
                      ]
                    }
                  },
                  "-children": [
                    {
                      "Transform": {
                        "@DEF": "PortalDisc",
                        "@rotation": [1, 0, 0, 1.5708],
                        "-children": [
                          {
                            "Shape": {
                              "-appearance": {
                                "Appearance": {
                                  "-material": {
                                    "Material": {
                                      "@diffuseColor": [1.0, 0.48, 0.23],
                                      "@emissiveColor": [0.55, 0.26, 0.12]
                                    }
                                  }
                                }
                              },
                              "-geometry": { "Cylinder": { "@radius": 1.1, "@height": 0.05 } }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "Transform": {
                        "@DEF": "PortalLabel",
                        "@translation": [0, 1.45, 0],
                        "-children": [
                          {
                            "Shape": {
                              "-appearance": { "Appearance": { "-material": { "Material": { "@emissiveColor": [1, 1, 1], "@diffuseColor": [1, 1, 1] } } } },
                              "-geometry": {
                                "Text": {
                                  "@string": ["Location B"],
                                  "-fontStyle": { "FontStyle": { "@justify": ["MIDDLE", "MIDDLE"], "@size": 0.35 } }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
