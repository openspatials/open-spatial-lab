{
  "name": "open-spatial-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained local Web of Worlds spatial-computing demo.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "bash ./launchOpenSpatialLab.sh",
    "stop": "bash ./stopOpenSpatialLab.sh",
    "demo-check": "node tools/verify-demo.mjs",
    "release-check": "node tools/verify-release.mjs",
    "trace-check": "node tools/trace-check.mjs",
    "verify": "npm run release-check && npm run trace-check && npm run demo-check",
    "proof:crossing": "node tools/wow-conformance/crossing-proof.js",
    "proof:portal": "node tools/wow-conformance/portal-proof.js",
    "proof:spatial-graph": "node runtime/world-server/test/spatial-graph-proof.js",
    "proof:contract": "node runtime/world-server/test/contract-enforcement-proof.js",
    "proof:presence": "node runtime/world-server/test/ws-events-presence-proof.js",
    "proof:acceptance": "node runtime/world-server/test/acceptance.test.js",
    "conformance": "node tools/wow-conformance/run.js",
    "conformance:fixtures": "node wow-spec/conformance-fixtures/run.mjs",
    "wow-schema-json": "node wow-spec/build-schema-json.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.3.3",
    "three": "0.173.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "5.2.1",
    "puppeteer-core": "22.15.0"
  }
}
