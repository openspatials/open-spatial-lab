+    GeoPose:
+      description: >-
+        OGC GeoPose 1.0 Basic-YPR. `position` is latitude and longitude in degrees, and `h` in meters
+        above the WGS-84 ellipsoid. `angles` are `yaw`, `pitch` and `roll` in degrees, as OGC GeoPose 1.0 Basic-YPR
+        defines them. A writer MUST send `lon`. A reader MUST also accept `lan`, the earlier
+        spelling, and MUST refuse a position whose `lon` and `lan` differ. A server MUST NOT emit `lan`.
+      type: object
+      required: [position, angles]
+      properties:
+        position:
+          type: object
+          required: [lat, h]
+          anyOf:
+            - required: [lon]
+            - required: [lan]
+          properties:
+            lat:
+              type: number
+              minimum: -90
+              maximum: 90
+            lon:
+              type: number
+              minimum: -180
+              maximum: 180
+            lan:
+              type: number
+              minimum: -180
+              maximum: 180
+              deprecated: true
+              description: Earlier spelling of `lon`.
+            h:
+              type: number
+        angles:
+          type: object
+          required: [yaw, pitch, roll]
+          properties:
+            yaw:
+              type: number
+            pitch:
+              type: number
+            roll:
+              type: number
