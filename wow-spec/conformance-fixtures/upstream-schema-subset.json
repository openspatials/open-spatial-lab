{
  "license": "Apache-2.0",
  "source": "OpenSpatialWorld WoWAPI@d39a1a0 canonical schema subset",
  "schemas": {
    "GeoPose": {
      "type": "object",
      "properties": {
        "position": { "type": "object", "properties": { "lat": { "type": "number" }, "lan": { "type": "number" }, "h": { "type": "number" } } },
        "angles": { "type": "object", "properties": { "yaw": { "type": "number" }, "pitch": { "type": "number" }, "roll": { "type": "number" } } }
      }
    },
    "World": {
      "type": "object",
      "properties": {
        "content": { "type": "object", "properties": { "label": { "type": "string" }, "age_restriction": { "type": "number" }, "license": { "type": "string" }, "cost": { "type": "string" }, "version": { "type": "number" }, "duration": { "type": "number" } } },
        "geoPose": { "$ref": "#/schemas/GeoPose" },
        "presence": { "type": "object", "properties": { "avatar": { "type": "string" }, "navigation": { "type": "string" }, "gravity": { "type": "string" } } },
        "technology": { "type": "object", "properties": { "webXR-immersive": { "type": "string" }, "runtime": { "type": "string" } } },
        "users": { "type": "object", "properties": { "active_user_count": { "type": "integer" }, "total_user_count": { "type": "integer" } } },
        "views": { "type": "object", "properties": { "view_count": { "type": "integer" } } },
        "portals": { "type": "object", "properties": { "portal_count": { "type": "integer" } } }
      }
    },
    "User": { "type": "object", "properties": { "id": { "type": "number" }, "name": { "type": "string" }, "AvatarURI": { "type": "string" }, "geoPose": { "$ref": "#/schemas/GeoPose" } } },
    "Node": { "type": "object", "properties": { "id": { "type": "integer" }, "label": { "type": "string" }, "names": { "type": "array", "items": { "type": "string" } }, "parent": { "type": "integer" }, "children": { "type": "array", "items": { "$ref": "#/schemas/Node" } }, "localTransform": { "type": "array", "items": { "type": "number" } }, "spatialAssetURI": { "type": "string" }, "appearanceURI": { "type": "string" } } },
    "Portal": { "type": "object", "properties": { "id": { "type": "number" }, "geoPose": { "$ref": "#/schemas/GeoPose" } } },
    "View": { "type": "object", "properties": { "id": { "type": "number" }, "geoPose": { "$ref": "#/schemas/GeoPose" } } },
    "Spatial": { "type": "object", "properties": { "id": { "type": "number" }, "rootNodeID": { "type": "number" }, "geoPose": { "$ref": "#/schemas/GeoPose" } } }
  }
}
